{
  "id": "plugin-builder",
  "name": "插件工坊",
  "version": "1.1.0",
  "description": "评估、设计并构建受信任运行时插件：统一 UI 树、版本化服务、显式菜单、Node.js 工具、命令、API、频道和持久化存储",
  "author": "Artificer",
  "icon": "puzzle",
  "entrypoints": {
    "api": "server.js"
  },
  "permissions": [
    "filesystem",
    "settings"
  ],
  "scenario": {
    "id": "plugin-builder-assistant",
    "name": "插件工坊",
    "description": "评估并创建运行时插件，使用统一 UI 树和版本化服务实现页面、面板与复杂状态",
    "capabilities": [
      "plugin_feasibility",
      "plugin_design",
      "runtime_ui_plugin_development",
      "ui_implementation"
    ],
    "promptFile": "prompts/plugin-builder.md",
    "access": {
      "tools": [
        "askUser",
        "listRuntimeUiPlugins",
        "removeRuntimeUiPlugin",
        "readRuntimeUiPluginFile",
        "writeRuntimeUiPluginFiles",
        "buildRuntimeUiPlugin",
        "searchWeb",
        "fetchUrl",
        "calculate",
        "readContext"
      ],
      "skills": [
        "plugin-builder-integration"
      ]
    },
    "config": {
      "temperature": 0.3,
      "maxOutputTokens": 16384,
      "enableHistory": true
    }
  },
  "engines": {
    "artificer": ">=1.1.6"
  },
  "skills": [
    {
      "file": "skills/integration.md"
    }
  ]
}
