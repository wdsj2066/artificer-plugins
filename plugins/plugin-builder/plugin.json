{
  "id": "plugin-builder",
  "name": "插件工坊",
  "version": "1.0.4",
  "description": "评估、设计并构建受信任运行时插件：支持 Vue 页面与面板、显式扩展菜单、内置或资源图标，以及 Node.js 工具、命令、API、频道和持久化存储",
  "author": "Artificer",
  "icon": "puzzle",
  "entrypoints": {
    "api": "server.js"
  },
  "permissions": [
    "filesystem",
    "settings"
  ],
  "scenario": {
    "id": "plugin-builder-assistant",
    "name": "插件工坊",
    "description": "评估并创建运行时插件，明确区分页面与菜单入口，配置图标资源，接入 Vue UI 与 Node.js 后端能力",
    "capabilities": [
      "plugin_feasibility",
      "plugin_design",
      "runtime_ui_plugin_development",
      "ui_implementation"
    ],
    "promptFile": "prompts/plugin-builder.md",
    "access": {
      "tools": [
        "askUser",
        "listRuntimeUiPlugins",
        "removeRuntimeUiPlugin",
        "readRuntimeUiPluginFile",
        "writeRuntimeUiPluginFiles",
        "buildRuntimeUiPlugin",
        "searchWeb",
        "fetchUrl",
        "calculate",
        "readContext"
      ],
      "skills": [
        "plugin-builder-integration"
      ]
    },
    "config": {
      "temperature": 0.3,
      "maxOutputTokens": 16384,
      "enableHistory": true
    }
  },
  "engines": {
    "artificer": ">=1.1.5"
  },
  "skills": [
    {
      "file": "skills/integration.md"
    }
  ]
}
